import time
from controller import Controller

motor = Controller()

# PID gains
KP = 0.01
KI = 0.0008
KD = 0.001

SAMPLE_DT = 0.05

def measure_velocity(dt):
    """Return (left_vel, right_vel) in ticks/s."""
    l1, r1 = motor.get_encoder_ticks()
    time.sleep(dt)
    l2, r2 = motor.get_encoder_ticks()
    return (l2 - l1) / dt, (r2 - r1) / dt


def pid_step(target, v_meas, u, err_int, last_v):
    """One PID update for a single motor."""
    err = target - v_meas
    err_int += err * SAMPLE_DT

    dv = (v_meas - last_v) / SAMPLE_DT
    last_v = v_meas

    u = u + KP * err + KI * err_int - KD * dv
    u = max(min(u, 127), 0)

    return u, err_int, last_v


def run_velocity_control(target_left, target_right, run_time=3.0):
    """Run dual closed-loop velocity control for a few seconds."""
    uL = 60.0
    uR = 60.0

    err_int_L = 0.0
    err_int_R = 0.0

    last_vL = 0.0
    last_vR = 0.0

    t0 = time.time()

    while time.time() - t0 < run_time:
        vL, vR = measure_velocity(SAMPLE_DT)

        uL, err_int_L, last_vL = pid_step(target_left, vL, uL, err_int_L, last_vL)
        uR, err_int_R, last_vR = pid_step(target_right, vR, uR, err_int_R, last_vR)

        motor.set_raw_motor_speed(int(uL), int(uR))

        print(f"L: v={vL:.1f} u={uL:.1f} | R: v={vR:.1f} u={uR:.1f}")

    motor.set_raw_motor_speed(0, 0)
    print("Motors stopped")


# Example:
run_velocity_control(5500.0, 5500.0, run_time=3.0)
